{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:base",
		"security:minimumReleaseAgeNpm",
		":gitSignOff"
	],
	"automerge": true,
	"automergeType": "pr",
	"baseBranches": [
		"master"
	],
	"branchConcurrentLimit": 5,
	"cloneSubmodules": true,
	"lockFileMaintenance": {
		"enabled": true
	},
	"packageRules": [
		{
			"matchPackagePrefixes": [
				"eslint",
				"@typescript-eslint/",
				"oxlint/"
			],
			"labels": [
				"linting"
			]
		},
	    {
			"matchPackageNames": ["vapoursynth"],
			"matchCurrentVersion": "<=74",
			"allowedVersions": "<=74"
	    },
	    {
			"matchPackageNames": ["vapoursynth"],
			"matchCurrentVersion": ">=75,<=79",
			"allowedVersions": "<=79"
	    }
	],
	"schedule": [
		"* 8 */5 * *"
	],
	"vulnerabilityAlerts": {
		"labels": ["security"],
		"automerge": true
	},
	"major": {
		"dependencyDashboardApproval": true
	}
}
